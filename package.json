{
  "name": "wupage",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:firefox": "vite build --mode firefox",
    "dev:firefox": "vite build --mode firefox --watch",
    "test:firefox": "node scripts/test-firefox.mjs",
    "dev": "vite build --watch",
    "test": "vitest run --exclude \"**/.npm-cache/**\"",
    "test:page": "node scripts/test-page-translation.mjs",
    "test:cards": "node scripts/test-card-layout.mjs",
    "test:auto": "node scripts/test-auto-translation.mjs",
    "test:floating": "node scripts/test-floating-interactions.mjs",
    "test:settings": "node scripts/test-settings-initialization.mjs",
    "test:services": "node scripts/test-service-modes.mjs",
    "test:ocr": "node scripts/test-ocr-flow.mjs",
    "test:ocr-runtime": "node scripts/test-ocr-runtime.mjs",
    "test:local": "node scripts/test-local-translation.mjs",
    "test:pdf": "node scripts/test-pdf-corpus.mjs",
    "test:pdf-scope": "node scripts/test-pdf-scope.mjs",
    "test:github-code": "node scripts/test-github-code-comments.mjs",
    "test:image-resolution": "node scripts/test-image-resolution.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.34",
    "@types/node": "^24.0.14",
    "esbuild": "0.28.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.0.5",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@browsermt/bergamot-translator": "0.4.9",
    "@paddleocr/paddleocr-js": "0.4.2",
    "onnxruntime-web": "1.30.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200"
  }
}
